{
  "openapi": "3.1.0",
  "info": {
    "title": "Turnero API",
    "version": "0.1.0"
  },
  "paths": {
    "/public/barberias/{slug}": {
      "get": {
        "tags": [
          "público"
        ],
        "summary": "Obtener Barberia",
        "description": "Con `servicio`, solo los barberos que lo prestan y su próximo turno para ese servicio (RF-03).",
        "operationId": "obtener_barberia_public_barberias__slug__get",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          },
          {
            "name": "servicio",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Servicio"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BarberiaPublica"
                }
              }
            }
          },
          "404": {
            "description": "No existe o está suspendida (CU-01 1a)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/public/barberias/{slug}/turnos": {
      "get": {
        "tags": [
          "público"
        ],
        "summary": "Obtener Turnos",
        "description": "Turnos libres de `fecha` (local de la barbería). Sin `miembro` es \"el primero disponible\" (RN-05).\n\nUn servicio o barbero que no es de la barbería, o que no se prestan entre sí, da una lista vacía.",
        "operationId": "obtener_turnos_public_barberias__slug__turnos_get",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          },
          {
            "name": "servicio",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Servicio"
            }
          },
          {
            "name": "fecha",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Fecha"
            }
          },
          {
            "name": "miembro",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Miembro"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TurnoPublico"
                  },
                  "title": "Response Obtener Turnos Public Barberias  Slug  Turnos Get"
                }
              }
            }
          },
          "404": {
            "description": "No existe o está suspendida (CU-01 1a)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/public/citas": {
      "post": {
        "tags": [
          "público"
        ],
        "summary": "Crear Cita",
        "description": "CU-01 · Reserva sin cuenta. El token se devuelve solo esta vez.",
        "operationId": "crear_cita_public_citas_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NuevaCitaPublica"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CitaCreadaPublica"
                }
              }
            }
          },
          "404": {
            "description": "La barbería no existe o está suspendida (RN-16)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "409": {
            "description": "`turno_ocupado` (CU-01 9a), `maximo_citas` (9b) o `seleccion_no_disponible`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "422": {
            "description": "`telefono_invalido` (CU-01 8a) o datos inválidos (sin aceptar la política, RF-06)"
          },
          "429": {
            "description": "Límite de reservas por IP (CU-01 9c)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BarberiaPublica": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "direccion": {
            "type": "string",
            "title": "Direccion"
          },
          "telefono_contacto": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Telefono Contacto"
          },
          "zona": {
            "type": "string",
            "title": "Zona"
          },
          "servicios": {
            "items": {
              "$ref": "#/components/schemas/ServicioPublico"
            },
            "type": "array",
            "title": "Servicios"
          },
          "barberos": {
            "items": {
              "$ref": "#/components/schemas/BarberoPublico"
            },
            "type": "array",
            "title": "Barberos"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "nombre",
          "direccion",
          "telefono_contacto",
          "zona",
          "servicios",
          "barberos"
        ],
        "title": "BarberiaPublica"
      },
      "BarberoPublico": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "proximo_turno": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proximo Turno"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "proximo_turno"
        ],
        "title": "BarberoPublico"
      },
      "CitaCreadaPublica": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "CitaCreadaPublica"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NuevaCitaPublica": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "servicio_id": {
            "type": "string",
            "format": "uuid",
            "title": "Servicio Id"
          },
          "miembro_id": {
            "type": "string",
            "format": "uuid",
            "title": "Miembro Id"
          },
          "inicio": {
            "type": "string",
            "format": "date-time",
            "title": "Inicio"
          },
          "nombre": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Nombre"
          },
          "telefono": {
            "type": "string",
            "maxLength": 30,
            "title": "Telefono"
          },
          "acepta_politica": {
            "type": "boolean",
            "const": true,
            "title": "Acepta Politica"
          },
          "acepta_marketing": {
            "type": "boolean",
            "title": "Acepta Marketing",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "slug",
          "servicio_id",
          "miembro_id",
          "inicio",
          "nombre",
          "telefono",
          "acepta_politica"
        ],
        "title": "NuevaCitaPublica"
      },
      "RespuestaError": {
        "properties": {
          "codigo": {
            "type": "string",
            "title": "Codigo"
          },
          "mensaje": {
            "type": "string",
            "title": "Mensaje"
          },
          "datos": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Datos"
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "mensaje"
        ],
        "title": "RespuestaError",
        "description": "Cuerpo de todo error de dominio. La web decide con `codigo`; `mensaje` se puede mostrar tal cual."
      },
      "ServicioPublico": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "duracion_min": {
            "type": "integer",
            "title": "Duracion Min"
          },
          "precio_cop": {
            "type": "integer",
            "title": "Precio Cop"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "duracion_min",
          "precio_cop"
        ],
        "title": "ServicioPublico"
      },
      "TurnoPublico": {
        "properties": {
          "inicio": {
            "type": "string",
            "format": "date-time",
            "title": "Inicio"
          },
          "miembro_id": {
            "type": "string",
            "format": "uuid",
            "title": "Miembro Id"
          }
        },
        "type": "object",
        "required": [
          "inicio",
          "miembro_id"
        ],
        "title": "TurnoPublico"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
